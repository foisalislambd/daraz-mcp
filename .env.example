# Copy to .env. Never commit real secrets.

# Web
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_APP_URL=http://localhost:3000
# Session cookie Secure flag. Defaults to on in production when PUBLIC_APP_URL is https or unset.
# Set false for a local production server on http.
COOKIE_SECURE=
# 32-byte key, base64. Required in production. Example generation:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# postgres://daraz:daraz@localhost:5432/daraz
# Omit to use SQLite at apps/web/data/daraz.sqlite
DATABASE_URL=
SQLITE_PATH=

# Optional platform Daraz app used by hosted OAuth.
# Sellers can also paste their own app key and secret in the panel.
DARAZ_APP_KEY=
DARAZ_APP_SECRET=
DARAZ_REGION=BD

# Local demo account. Leave SEED_DEMO unset in production.
SEED_DEMO=false
DEMO_EMAIL=demo@daraz-mcp.local
DEMO_PASSWORD=demo-password

# Local MCP process (alternative to the encrypted config file)
# DARAZ_ACCESS_TOKEN=
# DARAZ_REFRESH_TOKEN=
# DARAZ_SHOP_ID=
# DARAZ_MCP_API_KEY=
# DARAZ_MCP_HOME=
