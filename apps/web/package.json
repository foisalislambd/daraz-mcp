{
  "name": "@daraz-mcp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosted Daraz MCP admin, built on the ZenPanel shell.",
  "scripts": {
    "dev": "node --experimental-strip-types server.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --experimental-strip-types server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@daraz-mcp/client": "workspace:*",
    "@daraz-mcp/mcp-server": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.2",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.15.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^3.1.4"
  }
